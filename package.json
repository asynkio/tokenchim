{
  "name": "tokenchim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data": "node --import tsx scripts/prepare-data.ts",
    "download": "node scripts/download.mjs",
    "test": "pnpm run test:core && pnpm run test:server",
    "test:browser": "playwright test",
    "format": "prettier --write src server scripts tests index.html rules.html package.json tsconfig.json vite.config.ts playwright.config.ts README.md",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx --watch server/index.ts",
    "start": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test:core": "node --import tsx tests/core.test.ts",
    "test:server": "node --import tsx tests/server.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1"
}
