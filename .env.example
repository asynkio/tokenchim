# Copy to .env.local; keep the real API key on the server only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DATABASE_PATH=var/tokenchim.sqlite
HOST=127.0.0.1
PORT=3001
# For a subpath build, match Vite --base (for example /tokenchim/).
BASE_PATH=/
# Trust only the directly connected single reverse proxy. Empty ignores proxy headers.
# With a local Nginx proxy: TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUSTED_PROXY_IPS=
API_RATE_LIMIT_PER_MINUTE=120
DRAW_RATE_LIMIT_PER_MINUTE=20
READING_RATE_LIMIT_PER_MINUTE=6
READING_CONCURRENCY=2
# Global daily model attempts, resets at 00:00 Asia/Shanghai; 0 pauses new readings.
READING_DAILY_LIMIT=500
